# AlphaRadar 环境变量模板（绝不提交真实密钥）
# 扶摇：https://fuyao.aicubes.cn/admin 登录后一键签发（免费，不限累计调用）
FUYAO_API_KEY=
FUYAO_API_BASE=https://fuyao.aicubes.cn

# iFinD MCP：https://mcp.51ifind.com 个人中心-密钥（免费体验版限流 2 请求/秒）
IFIND_API_KEY=
IFIND_MCP_BASE=https://api-mcp.51ifind.com:8643/ds-mcp-servers

# 可选：LLM 增强通道（OpenAI 兼容协议）；不配置则走内置确定性 NL 编译器
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 无密钥/上游失败时的高仿真回退（所有结论显式标注"离线演示，非实时"）
ENABLE_HIGH_FIDELITY_FALLBACK=true

# 数据库（默认 SQLite）
DATABASE_URL=sqlite:///./radar.db

# 全局调度巡检周期（秒）
SCHEDULER_TICK_SECONDS=30

# Jev（TypeSafe System One）可选：结构化语义判断（合规护栏增强 + 公告情绪归因）
# https://console.typesafe.ai/keys
JEV_API_KEY=
JEV_MODEL=jev-latest
